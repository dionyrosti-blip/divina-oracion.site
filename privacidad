ze: 16px;line-height: 1.7em;color: rgba(55,55,75,1);} .a-c-cont-f679be3 > .a-e-cont {} .a-c-cont-f679be3 > .a-e-cont:hover {}.a-e-a-f679be3 {}</style><div class="a-r atomicat-text-f679be3 atomicat-element-container-f679be3  atomicat-heading-title a-e-cont atomicat-heading-title-f679be3 a-s-d-lzd868"><!-- text - w3cuhb --><h3 class="       a-i-e-cont ">En www.oracion-divina.site (en adelante, "el Sitio") nos comprometemos a proteger tu privacidad. Esta Política de Privacidad describe cómo recopilamos, usamos y protegemos tu información personal cuando accedes a nuestros servicios.</h3></div></div><div class="a-s-d-926jap a-r a-c-cont a-c-cont-10446c5"><style>.a-c-cont-10446c5 {}.a-c-cont.a-c-cont-10446c5 {}.a-e-cont.atomicat-heading-title-10446c5 h3:hover {-webkit-text-fill-color: unset;}.a-e-cont.atomicat-heading-title-10446c5 h3 {font-size: 22px;font-weight: 700;color: rgba(20,20,40,1);} .a-c-cont-10446c5 > .a-e-cont {} .a-c-cont-10446c5 > .a-e-cont:hover {}.a-e-a-10446c5 {}</style><div class="atomicat-element-container-10446c5 atomicat-heading-title-10446c5  a-r atomicat-text-10446c5 atomicat-heading-title a-s-d-35dzuo a-e-cont"><h3 class="    a-i-e-cont    ">1. Información que Recopilamos</h3></div></div><div class="a-c-cont-3fd7118 a-r a-c-cont"><style>.a-c-cont-3fd7118 {}.a-c-cont.a-c-cont-3fd7118 {}.a-e-cont.atomicat-heading-title-3fd7118 h3:hover {-webkit-text-fill-color: unset;}.a-e-cont.atomicat-heading-title-3fd7118 h3 {font-size: 15px;line-height: 1.8em;color: rgba(55,55,75,1);} .a-c-cont-3fd7118 > .a-e-cont {} .a-c-cont-3fd7118 > .a-e-cont:hover {}.a-e-a-3fd7118 {}</style><div class="atomicat-heading-title atomicat-element-container-3fd7118  atomicat-heading-title-3fd7118 a-e-cont atomicat-text-3fd7118 a-r"><!-- text - eb1b13 --><h3 class="        a-i-e-cont">Podemos recopilar la siguiente información cuando utilizas nuestro Sitio:<br /><br />• Nombre completo<br />• Dirección de correo electrónico<br />• Datos de pago (procesados de forma segura por nuestro proveedor de pagos; no almacenamos datos de tarjetas)<br />• Dirección IP y datos de navegación (a través de cookies)<br />• Información que nos proporcionas voluntariamente a través del formulario de contacto</h3></div></div><div class="a-c-cont-9f07616 a-r a-s-d-svi66c a-c-cont"><style>.a-c-cont-9f07616 {}.a-c-cont.a-c-cont-9f07616 {}.a-e-cont.atomicat-heading-title-9f07616 h3:hover {-webkit-text-fill-color: unset;}.a-e-cont.atomicat-heading-title-9f07616 h3 {font-size: 22px;font-weight: 700;color: rgba(20,20,40,1);} .a-c-cont-9f07616 > .a-e-cont {} .a-c-cont-9f07616 > .a-e-cont:hover {}.a-e-a-9f07616 {}</style><div class="atomicat-text-9f07616 atomicat-heading-title atomicat-element-container-9f07616 a-r atomicat-heading-title-9f07616 a-s-d-dwrhh6  a-e-cont"><!-- text - y3fcwp --><h3 class="    a-i-e-cont    ">2. Uso de la Información</h3></div></div><div class="a-c-cont-d9c23a0 a-r a-s-d-1yyalb a-c-cont"><style>.a-c-cont-d9c23a0 {}.a-c-cont.a-c-cont-d9c23a0 {}.a-e-cont.atomicat-heading-title-d9c23a0 h3:hover {-webkit-text-fill-color: unset;}.a-e-cont.atomicat-heading-title-d9c23a0 h3 {font-size: 15px;line-height: 1.8em;color: rgba(55,55,75,1);} .a-c-cont-d9c23a0 > .a-e-cont {} .a-c-cont-d9c23a0 > .a-e-cont:hover {}.a-e-a-d9c23a0 {}</style><div class="atomicat-element-container-d9c23a0  atomicat-heading-title atomicat-heading-title-d9c23a0 a-s-d-1j7wh6 a-e-cont atomicat-text-d9c23a0 a-r"><!-- text - h0w96b --><h3 class="a-i-e-cont        ">Utilizamos tu información para:<br /><br />• Procesar y entregar los productos digitales adquiridos<br />• Enviar comunicaciones relacionadas con tu compra<br />• Responder a solicitudes de soporte<br />• Mejorar la experiencia de usuario en el Sitio<br />• Cumplir con obligaciones legales y prevenir fraudes</h3></div></div><div class="a-s-d-kiehrg a-c-cont a-r a-c-cont-2340e39"><style>.a-c-cont-2340e39 {}.a-c-cont.a-c-cont-2340e39 {}.a-e-cont.atomicat-heading-title-2340e39 h3:hover {-webkit-text-fill-color: unset;}.a-e-co